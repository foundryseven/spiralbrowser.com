---
import Base from '../../layouts/Base.astro';
import { t, locales, defaultLocale, type Locale } from '../../i18n';

export async function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };

const sections = [
  { title: t(locale, 'colophon.role.title'), body: t(locale, 'colophon.role.body') },
  { title: t(locale, 'colophon.decides.title'), body: t(locale, 'colophon.decides.body') },
  { title: t(locale, 'colophon.doesnt-decide.title'), body: t(locale, 'colophon.doesnt-decide.body') },
  { title: t(locale, 'colophon.why.title'), body: t(locale, 'colophon.why.body') },
  { title: t(locale, 'colophon.limits.title'), body: t(locale, 'colophon.limits.body') },
];
---

<Base title={t(locale, 'colophon.title')} locale={locale}>
  <section class="container-wide py-16 md:py-24">
    <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">{t(locale, 'colophon.title')}</h1>
  </section>

  <section class="border-t border-border/40">
    <div class="container-prose py-16">
      <div class="space-y-12">
        {sections.map((s) => (
          <div>
            <h2 class="text-2xl font-semibold tracking-tight">{s.title}</h2>
            <p class="mt-3 text-muted-foreground">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
